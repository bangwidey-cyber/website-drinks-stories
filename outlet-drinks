<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drinks Stories - Coffee & Treats Tangerang</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,600&display=swap" rel="stylesheet">
    <style>
        :root {
            --dark-brown: #4A2C2A;
            --dark-brown-hover: #37201E;
            --warm-cream: #F5E6D3;
            --light-cream: #FCF8F2;
            --accent-warm: #C28B5E;
            --text-main: #2D1A19;
            --text-muted: #6B5553;
            --white: #FFFFFF;
            --shadow-subtle: 0 8px 24px rgba(74, 44, 42, 0.08);
            --radius-md: 14px;
            --radius-lg: 20px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--light-cream);
            color: var(--text-main);
            line-height: 1.6;
        }

        .container {
            max-width: 1160px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .section {
            padding: 90px 0;
        }

        .section-header {
            text-align: center;
            max-width: 680px;
            margin: 0 auto 52px;
        }

        .section-tag {
            display: inline-block;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--accent-warm);
            margin-bottom: 10px;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.3rem;
            color: var(--dark-brown);
            margin-bottom: 14px;
        }

        .section-desc {
            color: var(--text-muted);
            font-size: 1rem;
        }

        /* Nav */
        nav {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 50;
            padding: 24px 0;
            background: linear-gradient(180deg, rgba(30, 16, 15, 0.7) 0%, transparent 100%);
        }

        .nav-wrap {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand-logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.65rem;
            font-weight: 700;
            color: var(--warm-cream);
            text-decoration: none;
            letter-spacing: 0.5px;
        }

        .nav-links {
            display: flex;
            gap: 28px;
            align-items: center;
        }

        .nav-links a {
            color: var(--warm-cream);
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .nav-links a:hover {
            color: var(--white);
        }

        /* 1. Hero Section - Update Background Image */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            background-image: url('https://i.ibb.co.com/yFYNXM4X/image.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(46, 25, 23, 0.65) 0%, rgba(30, 16, 15, 0.82) 100%);
        }

        .hero-content {
            position: relative;
            z-index: 10;
            max-width: 820px;
            padding: 0 20px;
        }

        .hero-title {
            font-family: 'Playfair Display', serif;
            font-size: 4rem;
            color: var(--warm-cream);
            letter-spacing: 1px;
            margin-bottom: 18px;
        }

        .hero-tagline {
            font-size: 1.25rem;
            font-weight: 500;
            color: #EDE0D4;
            margin-bottom: 36px;
            letter-spacing: 0.5px;
        }

        .hero-actions {
            display: flex;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 13px 28px;
            font-size: 0.95rem;
            font-weight: 700;
            border-radius: 50px;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.25s ease;
            border: none;
        }

        .btn-primary {
            background-color: var(--accent-warm);
            color: var(--white);
        }

        .btn-primary:hover {
            background-color: #A97449;
            transform: translateY(-2px);
        }

        .btn-outline {
            background-color: transparent;
            color: var(--warm-cream);
            border: 2px solid var(--warm-cream);
        }

        .btn-outline:hover {
            background-color: var(--warm-cream);
            color: var(--dark-brown);
        }

        /* 2. Tentang Kami */
        .about {
            background-color: var(--warm-cream);
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 56px;
            align-items: center;
        }

        .about-text p {
            font-size: 1.05rem;
            color: var(--text-muted);
            margin-bottom: 18px;
        }

        .about-highlights {
            display: flex;
            gap: 24px;
            margin-top: 30px;
        }

        .highlight-item {
            border-left: 3px solid var(--dark-brown);
            padding-left: 14px;
        }

        .highlight-item strong {
            display: block;
            font-size: 1.3rem;
            color: var(--dark-brown);
        }

        .highlight-item span {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .about-img-wrap {
            position: relative;
        }

        .about-img {
            width: 100%;
            height: 380px;
            object-fit: cover;
            border-radius: var(--radius-lg);
            box-shadow: 0 16px 36px rgba(74, 44, 42, 0.15);
        }

        /* 3. Menu Kategori Filter */
        .menu-tabs {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .tab-btn {
            background: transparent;
            border: 1.5px solid var(--dark-brown);
            color: var(--dark-brown);
            padding: 10px 24px;
            border-radius: 40px;
            font-family: inherit;
            font-size: 0.92rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .tab-btn.active, .tab-btn:hover {
            background-color: var(--dark-brown);
            color: var(--warm-cream);
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
        }

        .menu-item {
            background-color: var(--white);
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-subtle);
            border: 1px solid rgba(74, 44, 42, 0.08);
            transition: transform 0.25s ease, opacity 0.3s ease;
        }

        .menu-item:hover {
            transform: translateY(-4px);
        }

        .menu-item.hide {
            display: none;
        }

        /* Menjaga foto produk proporsional */
        .menu-thumb {
            width: 100%;
            height: 220px;
            object-fit: cover;
            object-position: center;
            display: block;
        }

        .menu-details {
            padding: 20px;
        }

        .menu-badge {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--accent-warm);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: inline-block;
            margin-bottom: 6px;
        }

        .menu-title {
            font-size: 1.15rem;
            color: var(--dark-brown);
            font-weight: 700;
            margin-bottom: 6px;
        }

        .menu-desc {
            font-size: 0.88rem;
            color: var(--text-muted);
            margin-bottom: 14px;
        }

        .menu-price {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--dark-brown);
        }

        /* 4. Galeri Grid 6 */
        .gallery {
            background-color: var(--warm-cream);
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .gallery-item {
            position: relative;
            overflow: hidden;
            border-radius: var(--radius-md);
            height: 240px;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: transform 0.4s ease;
            display: block;
        }

        .gallery-item:hover img {
            transform: scale(1.05);
        }

        /* 5. Jam Operasional dan Lokasi */
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: stretch;
        }

        .info-card {
            background-color: var(--white);
            padding: 36px;
            border-radius: var(--radius-lg);
            border: 1px solid rgba(74, 44, 42, 0.08);
            box-shadow: var(--shadow-subtle);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .info-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--dark-brown);
            margin-bottom: 18px;
        }

        .time-table {
            list-style: none;
            margin-bottom: 24px;
        }

        .time-table li {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px dashed rgba(74, 44, 42, 0.15);
            font-size: 0.95rem;
        }

        .location-address {
            margin-bottom: 16px;
            font-size: 0.95rem;
            color: var(--text-muted);
        }

        .map-placeholder {
            width: 100%;
            height: 200px;
            background-color: #EBD9C3;
            border-radius: var(--radius-md);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--dark-brown);
            text-align: center;
            padding: 20px;
            border: 1px dashed var(--accent-warm);
        }

        /* 6. Order & Reservasi */
        .cta-section {
            background-color: var(--dark-brown);
            color: var(--warm-cream);
            text-align: center;
        }

        .cta-section .section-title {
            color: var(--warm-cream);
        }

        .cta-section .section-desc {
            color: #DFCFBE;
        }

        .cta-buttons {
            display: flex;
            justify-content: center;
            gap: 18px;
            flex-wrap: wrap;
            margin-top: 36px;
        }

        .btn-food {
            background-color: #00AA13;
            color: var(--white);
        }

        .btn-food:hover {
            background-color: #008810;
            transform: translateY(-2px);
        }

        .btn-grab {
            background-color: #00B14F;
            color: var(--white);
        }

        .btn-grab:hover {
            background-color: #009341;
            transform: translateY(-2px);
        }

        .btn-wa-reserve {
            background-color: #25D366;
            color: var(--white);
        }

        .btn-wa-reserve:hover {
            background-color: #1EBE5D;
            transform: translateY(-2px);
        }

        /* 7. Footer */
        footer {
            background-color: #281615;
            color: #D3C1B5;
            padding: 56px 0 28px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 40px;
            padding-bottom: 40px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .footer-brand {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            color: var(--warm-cream);
            margin-bottom: 12px;
        }

        .footer-social-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--warm-cream);
            margin-bottom: 14px;
        }

        .social-links {
            display: flex;
            gap: 14px;
            list-style: none;
            flex-wrap: wrap;
        }

        .social-links a {
            display: inline-block;
            background-color: rgba(245, 230, 211, 0.1);
            color: var(--warm-cream);
            padding: 8px 16px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 0.88rem;
            transition: all 0.2s ease;
        }

        .social-links a:hover {
            background-color: var(--accent-warm);
            color: var(--white);
        }

        .footer-copyright {
            text-align: center;
            font-size: 0.85rem;
            color: #9D887E;
            margin-top: 28px;
        }

        /* Responsif Layar */
        @media (max-width: 900px) {
            .menu-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .gallery-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .about-grid, .info-grid, .footer-grid {
                grid-template-columns: 1fr;
            }

            .hero-title {
                font-size: 2.8rem;
            }
        }

        @media (max-width: 600px) {
            .section {
                padding: 64px 0;
            }

            .nav-links {
                display: none;
            }

            .hero-title {
                font-size: 2.2rem;
            }

            .hero-tagline {
                font-size: 1.05rem;
            }

            .menu-grid {
                grid-template-columns: 1fr;
            }

            .gallery-grid {
                grid-template-columns: 1fr;
            }

            .cta-buttons {
                flex-direction: column;
                align-items: stretch;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <nav>
        <div class="container nav-wrap">
            <a href="#" class="brand-logo">Drinks Stories</a>
            <div class="nav-links">
                <a href="#about">Cerita Kami</a>
                <a href="#menu">Daftar Menu</a>
                <a href="#gallery">Suasana</a>
                <a href="#info">Lokasi</a>
                <a href="#order" class="btn btn-primary" style="padding: 8px 18px; font-size: 0.85rem;">Pesan / Reservasi</a>
            </div>
        </div>
    </nav>

    <!-- 1. Hero Section -->
    <header class="hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1 class="hero-title">Drinks Stories</h1>
            <p class="hero-tagline">Minuman Terbaik Untuk Kapan pun dan Dimana pun</p>
            <div class="hero-actions">
                <a href="#menu" class="btn btn-primary">Lihat Menu Andalan</a>
                <a href="#order" class="btn btn-outline">Reservasi & Order Online</a>
            </div>
        </div>
    </header>

    <!-- 2. Tentang Kami -->
    <section class="section about" id="about">
        <div class="container">
            <div class="about-grid">
                <div class="about-text">
                    <span class="section-tag">Tentang Kami</span>
                    <h2 class="section-title">Kisah Hangat di Setiap Racikan Gelas Anda</h2>
                    <p>Lahir di sudut ramai Kota Tangerang, Drinks Stories bermula dari gagasan sederhana: menghadirkan kopi susu nikmat dan kudapan hangat yang bisa dinikmati siapa pun tanpa sekat. Kami percaya bahwa secangkir minuman berkualitas bukan sekadar pelepas dahaga, melainkan perantara obrolan santai, teman menyelesaikan tugas, hingga penutup hari yang lelah bagi semua kalangan.</p>
                    <p>Setiap menu diracik menggunakan bahan baku pilihan, biji kopi terkurasi, dan pemanis alami tanpa bahan pengawet. Baik Anda penikmat kopi garis keras, pencinta racikan manis non-coffee, maupun pemburu pastry segar yang baru keluar dari pemanggang, Drinks Stories selalu siap menyambut Anda dengan suasana yang nyaman dan ramah seperti rumah sendiri.</p>
                    <div class="about-highlights">
                        <div class="highlight-item">
                            <strong>100%</strong>
                            <span>Gula Asli Pilihan</span>
                        </div>
                        <div class="highlight-item">
                            <strong>10-45 th</strong>
                            <span>Ruang untuk Semua Usia</span>
                        </div>
                        <div class="highlight-item">
                            <strong>Fresh</strong>
                            <span>Baked Pastry Harian</span>
                        </div>
                    </div>
                </div>
                <div class="about-img-wrap">
                    <img src="https://placehold.co/600x500/4A2C2A/F5E6D3?text=Barista+Drinks+Stories" alt="Barista meracik kopi Drinks Stories" class="about-img">
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Menu dengan Tab Filter Kategori -->
    <section class="section" id="menu">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Menu Pilihan</span>
                <h2 class="section-title">Cita Rasa Favorit Anda</h2>
                <p class="section-desc">Pilih kategori menu andalan kami, mulai dari racikan kopi susu kaya rasa hingga butter pastry yang renyah.</p>
            </div>

            <!-- Tab Buttons -->
            <div class="menu-tabs">
                <button class="tab-btn active" data-category="all">Semua Menu</button>
                <button class="tab-btn" data-category="coffee">Coffee</button>
                <button class="tab-btn" data-category="non-coffee">Non-Coffee</button>
                <button class="tab-btn" data-category="snack">Snack & Pastry</button>
            </div>

            <!-- Grid Items -->
            <div class="menu-grid" id="menu-grid">
                <!-- Coffee 1: Gambar Baru Diperbarui -->
                <div class="menu-item" data-category="coffee">
                    <img src="https://i.ibb.co.com/XxG9X8NR/image.jpg" alt="Kopi Susu Aren Stories" class="menu-thumb">
                    <div class="menu-details">
                        <span class="menu-badge">Coffee • Signature</span>
                        <h3 class="menu-title">Kopi Susu Aren Stories</h3>
                        <p class="menu-desc">Espresso ganda, susu segar creamy, dengan sirup gula aren murni.</p>
                        <div class="menu-price">Rp 18.000</div>
                    </div>
                </div>

                <!-- Coffee 2 -->
                <div class="menu-item" data-category="coffee">
                    <img src="https://placehold.co/400x300/3A201E/F5E6D3?text=Caramel+Macchiato" alt="Caramel Macchiato" class="menu-thumb">
                    <div class="menu-details">
                        <span class="menu-badge">Coffee</span>
                        <h3 class="menu-title">Caramel Macchiato</h3>
                        <p class="menu-desc">Sentuhan foam lembut bertabur saus karamel gurih dan shot espresso pekat.</p>
                        <div class="menu-price">Rp 22.000</div>
                    </div>
                </div>

                <!-- Non-Coffee 1 -->
                <div class="menu-item" data-category="non-coffee">
                    <img src="https://placehold.co/400x300/604538/F5E6D3?text=Artisan+Chocolate" alt="Artisan Chocolate" class="menu-thumb">
                    <div class="menu-details">
                        <span class="menu-badge">Non-Coffee</span>
                        <h3 class="menu-title">Dark Velvet Chocolate</h3>
                        <p class="menu-desc">Kakao premium berpadu susu murni hangat, kaya antioksidan dan tidak serik.</p>
                        <div class="menu-price">Rp 19.000</div>
                    </div>
                </div>

                <!-- Non-Coffee 2 -->
                <div class="menu-item" data-category="non-coffee">
                    <img src="https://placehold.co/400x300/526B50/F5E6D3?text=Matcha+Creamy+Latte" alt="Matcha Creamy Latte" class="menu-thumb">
                    <div class="menu-details">
                        <span class="menu-badge">Non-Coffee</span>
                        <h3 class="menu-title">Kyoto Matcha Latte</h3>
                        <p class="menu-desc">Bubuk teh hijau Jepang asli dengan aroma menenangkan dan aftertaste lembut.</p>
                        <div class="menu-price">Rp 21.000</div>
                    </div>
                </div>

                <!-- Snack 1 -->
                <div class="menu-item" data-category="snack">
                    <img src="https://placehold.co/400x300/C28B5E/FFFFFF?text=Butter+Croissant" alt="Butter Croissant" class="menu-thumb">
                    <div class="menu-details">
                        <span class="menu-badge">Snack • Pastry</span>
                        <h3 class="menu-title">Golden Butter Croissant</h3>
                        <p class="menu-desc">Lapisan pastry garing di luar dan lembut berserat di dalam, dipanggang tiap pagi.</p>
                        <div class="menu-price">Rp 17.000</div>
                    </div>
                </div>

                <!-- Snack 2 -->
                <div class="menu-item" data-category="snack">
                    <img src="https://placehold.co/400x300/B57A4C/FFFFFF?text=Pain+Au+Chocolat" alt="Pain Au Chocolat" class="menu-thumb">
                    <div class="menu-details">
                        <span class="menu-badge">Snack • Pastry</span>
                        <h3 class="menu-title">Pain Au Chocolat</h3>
                        <p class="menu-desc">Pastry klasik Prancis isi batang dark chocolate leleh yang memanjakan lidah.</p>
                        <div class="menu-price">Rp 20.000</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Galeri Cafe Grid 6 Foto -->
    <section class="section gallery" id="gallery">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Galeri Outlet</span>
                <h2 class="section-title">Suasana Hangat & Nyaman</h2>
                <p class="section-desc">Sudut-sudut santai di Drinks Stories Tangerang untuk bekerja, berdiskusi, atau sekadar melepas penat.</p>
            </div>
            <div class="gallery-grid">
                <div class="gallery-item">
                    <img src="https://placehold.co/500x360/4A2C2A/F5E6D3?text=Area+Bar+Barista" alt="Area Bar Barista Drinks Stories">
                </div>
                <div class="gallery-item">
                    <img src="https://placehold.co/500x360/37201E/F5E6D3?text=Sudut+Membaca+Santai" alt="Sudut Membaca Santai">
                </div>
                <div class="gallery-item">
                    <img src="https://placehold.co/500x360/5C3835/F5E6D3?text=Pastry+Display+Case" alt="Etalase Pastry Hangat">
                </div>
                <div class="gallery-item">
                    <img src="https://placehold.co/500x360/6E4440/F5E6D3?text=Meja+Komunal+Nugas" alt="Meja Komunal Nugas Tangerang">
                </div>
                <div class="gallery-item">
                    <img src="https://placehold.co/500x360/80514C/F5E6D3?text=Outdoor+Area+Teduh" alt="Outdoor Area Teduh Sore">
                </div>
                <div class="gallery-item">
                    <img src="https://placehold.co/500x360/4A2C2A/EAD3BA?text=Nuansa+Malam+Estetik" alt="Nuansa Lampu Hangat Malam">
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Jam Operasional dan Lokasi -->
    <section class="section" id="info">
        <div class="container">
            <div class="section-header">
